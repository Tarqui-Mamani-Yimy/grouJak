# Clave compartida entre la app de login demo y el backend
API_KEY=dev-api-key-change-me
COMPANY_NAME=Demo Pyme

# SQLite local (sin Docker)
DATABASE_PATH=./data/sentinel.db

# App de demo: objetivo FIJO del escáner y del agente atacante.
# Debe ser loopback. Nunca se acepta un objetivo desde el cliente.
DEMO_APP_URL=http://127.0.0.1:8080
DEMO_HOST=app-login-demo
BACKEND_URL=http://127.0.0.1:8000

# Credenciales solo de la demo. No son reales y nunca se muestran en el panel.
DEMO_USER=ana
DEMO_PASSWORD=demo1234
DEMO_ATTACKER_SOURCE_IP=203.0.113.7

# Reglas (demo en vivo: 5 fallos / 60 s)
BRUTE_FORCE_THRESHOLD=5
BRUTE_FORCE_WINDOW_SECONDS=60
ALERT_DEDUP_SECONDS=300

# IA defensora (Claude). Si falta la key o el JSON no valida, se usa plantilla.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Agente atacante
MAX_ATTACK_STEPS=15
ATTACKER_TIMEOUT_SECONDS=120

# Telegram (long polling, sin webhook)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# CORS del panel
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
